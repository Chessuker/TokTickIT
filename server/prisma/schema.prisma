generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Every user has exactly one role (BR-13).
enum Role {
  Requester
  ITStaff
  Administrator
}

/// Lab 3 renamed `RequesterUser` to `User` in place (AD-02): the ids that
/// `Ticket.requesterId` already points at are unchanged, and the Lab 2 columns
/// (`name`, `email`, `department`, `isActive`) survive untouched. The legacy
/// Lab 1 `User` table was dropped in the same migration (specification.md §7).
model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  department         String?
  role               Role      @default(Requester)
  /// bcrypt hash. Empty string means "never seeded", which never matches a
  /// password, so a migrated-but-unseeded user cannot log in (AD-13).
  passwordHash       String    @default("")
  mustChangePassword Boolean   @default(true)
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tickets       Ticket[]             @relation("TicketRequester")
  ownedTickets  Ticket[]             @relation("TicketOwner")
  sessions      Session[]
  comments      TicketComment[]
  internalNotes TicketInternalNote[]

  // Lab 4 reverse relations only; no User column changes (specification.md §7).
  actionsPerformed  TicketAction[]       @relation("ActionPerformer")
  followUpsAssigned TicketAction[]       @relation("FollowUpAssignee")
  followUpsClosed   TicketAction[]       @relation("FollowUpCloser")
  actionsEdited     TicketAction[]       @relation("ActionEditor")
  statusChanges     TicketStatusChange[]

  @@index([isActive])
  @@index([role, isActive])
}

/// One row per live login (BR-10, AD-01). Only the SHA-256 of the cookie token
/// is stored; deleting the row is what logout and revocation mean.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]

  @@index([isActive])
}

model RelatedSystem {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@index([isActive])
}

/// The full workflow (BR-18). Which pairs are reachable from which is decided
/// by the transition matrix on the server, never by the enum.
/// Declared in workflow order (api-spec.md §3.9): Postgres sorts an enum by
/// declaration order, which is what `GET /api/staff/tickets?sort=status` uses.
enum TicketStatus {
  New
  Open
  InProgress
  WaitingForRequester
  Reopened
  Resolved
  Closed
  Cancelled
}

enum TicketPriority {
  Low
  Medium
  High
}

model Ticket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique
  summary      String
  description  String
  status       TicketStatus   @default(New)
  /// The Requested Priority: immutable once the ticket exists (BR-16).
  priority     TicketPriority
  /// IT Priority, copied from `priority` at create and changed only by IT Staff.
  itPriority   TicketPriority

  requesterId     String
  ownerId         String?
  categoryId      String
  relatedSystemId String?

  requesterResolvedAt DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?

  requester     User           @relation("TicketRequester", fields: [requesterId], references: [id])
  owner         User?          @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  category      Category       @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem? @relation(fields: [relatedSystemId], references: [id])

  attachments   Attachment[]
  comments      TicketComment[]
  internalNotes TicketInternalNote[]
  actions       TicketAction[]
  statusChanges TicketStatusChange[]

  /// Optimistic-concurrency counter (Lab 4 BR-19, DB-02). Moves only on
  /// status, owner and IT Priority changes — never on a comment or an Action
  /// — so recording work cannot invalidate a colleague's pending status change.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId, createdAt])
  @@index([requesterId, status])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([status])
  @@index([createdAt])
  @@index([ownerId, status])
  @@index([itPriority])
  @@index([updatedAt])
}

/// Public Comments: readable by the Requester, IT Staff and Administrators
/// (BR-04). Kept in its own table so no query can return an Internal Note by
/// mistake (AD-03).
model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

/// Internal Notes: IT Staff and Administrators only (BR-04, BR-23).
model TicketInternalNote {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

/// The follow-up an Action Taken may carry (Lab 4 BR-06, BR-07). `null` on the
/// Action means no follow-up was needed; `Open` is the only non-final state.
enum FollowUpStatus {
  Open
  Completed
  Cancelled
}

/// One Action Taken on a Ticket (Lab 4 FR-01 … FR-04, BR-01 … BR-12).
///
/// `ticketId` and `performedById` are set once and never updated (BR-01,
/// BR-03); both foreign keys are `Restrict` because an Action is an audit
/// record that must outlive nothing it points at (DB-01). There is no delete
/// path anywhere in the application (BR-08).
///
/// The four follow-up columns are all set or all null. A CHECK constraint in
/// the migration enforces it in the database itself, whatever code writes the
/// row (DB-03). Prisma does not model CHECK constraints, so it lives only in
/// the SQL.
model TicketAction {
  id              String   @id @default(uuid())
  ticketId        String
  /// Action Date/Time: when the work was done, entered by the user (BR-05).
  actionAt        DateTime
  description     String
  result          String
  attachmentNotes String?
  performedById   String

  followUpRequired   Boolean         @default(false)
  followUpNote       String?
  followUpAssigneeId String?
  followUpStatus     FollowUpStatus?
  followUpClosedAt   DateTime?
  followUpClosedById String?

  /// Client-generated id that makes a retried create harmless (BR-10).
  clientRequestId String? @unique
  /// Optimistic-concurrency counter for edits (BR-19).
  version         Int     @default(0)
  updatedById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket           Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  performedBy      User   @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  followUpAssignee User?  @relation("FollowUpAssignee", fields: [followUpAssigneeId], references: [id], onDelete: Restrict)
  followUpClosedBy User?  @relation("FollowUpCloser", fields: [followUpClosedById], references: [id], onDelete: Restrict)
  updatedBy        User?  @relation("ActionEditor", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([ticketId, actionAt])
  @@index([performedById, createdAt])
  @@index([followUpAssigneeId, followUpStatus])
  @@index([ticketId, followUpStatus])
}

/// Append-only status history (Lab 4 BR-18, DB-04). Written in the same
/// transaction as the status change it records; never updated or deleted.
/// `Ticket.status` stays the authoritative value — this table is the trail.
model TicketStatusChange {
  id          String       @id @default(uuid())
  ticketId    String
  fromStatus  TicketStatus
  toStatus    TicketStatus
  changedById String
  createdAt   DateTime     @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  changedBy User   @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

/// Attachments are never hard-deleted. `isRemoved` marks a soft removal and
/// `removedReason` / `removedAt` record why and when, so removed files stay
/// visible as metadata while becoming undownloadable.
model Attachment {
  id            String    @id @default(uuid())
  ticketId      String
  fileName      String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  isRemoved     Boolean   @default(false)
  removedReason String?
  removedAt     DateTime?
  uploadedAt    DateTime  @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, isRemoved])
}
