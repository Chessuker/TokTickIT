{
  "name": "toktickit",
  "version": "1.0.0",
  "description": "TokTickIT Fullstack Application with React, Bootstrap, Express, TypeScript & Prisma",
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test",
    "test:e2e": "playwright test",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:db:push": "npm --prefix server run prisma:db:push",
    "prisma:migrate": "npm --prefix server run prisma:migrate",
    "prisma:seed": "npm --prefix server run prisma:seed"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "marked": "^18.0.11"
  }
}
